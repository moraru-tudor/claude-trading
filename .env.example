# ─────────────────────────────────────────────────────────────
#  Claude Trading Desk – configuration
#  Copy to .env and edit. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# demo  = simulated market, no internet needed (UI preview only, numbers are fake)
# paper = REAL live market data, fake money (start here, run it for days)
# live  = REAL money. Signs swaps with WALLET_SECRET_KEY.
MODE=paper

# Required to enable MODE=live (exact string):
# CONFIRM_LIVE=I_UNDERSTAND_THIS_USES_REAL_MONEY

# How much you "put in" (USD). In live mode this should match what you funded the bot wallet with.
START_USD=81
# Session length in hours (video: 22:00 → 08:00 = 10h). New entries stop after this; open positions are still managed.
SESSION_HOURS=10

# ── Analyst (Claude) ──────────────────────────────────────────
# If set, Claude runs the bull/bear debate for every candidate. Without it, a rule-based analyst is used.
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5-5
# low | medium | high  (low = fast + cheap per call; raise if you want deeper analysis)
ANALYST_EFFORT=low
MAX_ANALYST_CALLS_PER_HOUR=60

# ── Risk ──────────────────────────────────────────────────────
MIN_POSITION_PCT=3
MAX_POSITION_PCT=8
MAX_POSITION_USD=25
MAX_OPEN_POSITIONS=4
STOP_LOSS_PCT=8
TAKE_PROFIT_PCT=30
TRAIL_ARM_PCT=15
TRAIL_PCT=10
MAX_HOLD_MIN=60
# Stop opening trades if equity drops this % below the session start
DAILY_LOSS_LIMIT_PCT=30

# ── Scanner filters ──────────────────────────────────────────
MIN_LIQUIDITY_USD=15000
MIN_MCAP_USD=50000
MAX_MCAP_USD=25000000
MIN_AGE_MIN=3
MAX_AGE_HOURS=72
MIN_VOL_M5_USD=2000

# ── Execution (live) ─────────────────────────────────────────
# Base58 secret key of a NEW, DEDICATED wallet (Phantom → add account → Settings → Export private key).
# Only fund it with what you can afford to lose. Never use your main wallet.
WALLET_SECRET_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
SLIPPAGE_BPS=300
MAX_PRIORITY_FEE_LAMPORTS=1000000
SOL_FEE_RESERVE=0.02

# ── Dashboard ────────────────────────────────────────────────
PORT=8787
# 127.0.0.1 = this computer only. Use 0.0.0.0 to open it from your phone on the same Wi-Fi (set DASHBOARD_TOKEN then).
HOST=127.0.0.1
DASHBOARD_TOKEN=
